# Port de l'API
PORT=3001

# Connexion Postgres (voir docker-compose.yml à la racine)
DATABASE_URL=postgres://ravito:ravito@localhost:5432/ravito

# Base utilisée par `npm test` (créée automatiquement par docker compose)
TEST_DATABASE_URL=postgres://ravito:ravito@localhost:5432/ravito_test

# Clé admin : nécessaire pour ajouter / modifier / supprimer des traces.
# Mets une longue valeur aléatoire, par ex. : node -e "console.log(crypto.randomUUID())"
ADMIN_TOKEN=change-moi

# Origine du front autorisée (CORS). Inutile en dev : Vite proxifie /api.
CORS_ORIGIN=http://localhost:5173

# Taille max d'un fichier GPX envoyé (en Mo)
MAX_UPLOAD_MB=10

# --- Production (voir DEPLOIEMENT.md) ---
# NODE_ENV=production        sert aussi le front compilé (client/dist)
# MIGRATE_ON_START=true      applique les migrations au démarrage
# STATIC_DIR=../client/dist  dossier du front, relatif à server/ (vide = API seule)
